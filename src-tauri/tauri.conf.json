{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZineSplit",
  "version": "1.1.0",
  "identifier": "io.github.hamzadv.zinesplit",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs",
    "beforeDevCommand": "node scripts/prepare-dist.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZineSplit",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "Graphics",
    "shortDescription": "Read your printed zine as a book.",
    "longDescription": "Drop in the printed sheets of your zine and ZineSplit cuts each one down the middle, puts the pages back in reading order, and shows the zine as two-page spreads you can turn.",
    "copyright": "Copyright (c) 2026 Hamza",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
